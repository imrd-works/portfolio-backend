# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token
# Your numeric chat id (get it from @userinfobot or the getUpdates API)
TELEGRAM_CHAT_ID=123456789
# api.telegram.org does not answer from Yandex Cloud's Russian data centres. Until a relay
# abroad is set here (a Cloudflare Worker passing calls on to api.telegram.org), Telegram
# simply fails and the letter still goes by mail.
# TELEGRAM_API_BASE=https://tg-relay.example.workers.dev
# TELEGRAM_RELAY_SECRET=a-long-random-string-the-relay-checks

# --- Mail (SMTP) ---
# The letter also goes by mail; it is delivered if either way takes it.
# Yandex Mail: an app password (id.yandex.ru > Security > App passwords > Mail),
# with mail programs allowed in Yandex Mail's settings.
SMTP_USER=imld.works@yandex.ru
SMTP_PASS=app-password
# Optional: defaults are smtp.yandex.ru, 465 and SMTP_USER as the recipient.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# MAIL_TO=imld.works@yandex.ru

# --- CORS ---
# Origin of the portfolio site allowed to call this API.
# Use a comma-separated list for several, or * to allow any origin.
ALLOWED_ORIGIN=https://rassomakhin.com,https://www.rassomakhin.com

# --- Anti-self-submission (optional) ---
# Visitors must leave THEIR contacts, not yours — these are rejected if pasted.
OWNER_EMAIL=imld.works@yandex.ru
OWNER_TELEGRAM=@IIMRD

# --- Local dev only ---
PORT=3000
